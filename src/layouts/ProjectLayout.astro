---
import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  /** The project name on its own, without the " | Site name" suffix. */
  name?: string;
  author?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  repo?: string;
  url?: string;
};

const { site } = config;

const {
  title,
  description,
  ogImage,
  canonicalURL,
  name,
  author,
  pubDatetime,
  modDatetime,
  repo,
  url,
} = Astro.props;

/**
 * A project is not a BlogPosting, so this does not reuse PostLayout.
 *
 * With a public repository the precise type is SoftwareSourceCode, which is
 * what `codeRepository` belongs to; without one there is nothing to point at
 * and CreativeWork is the honest, less specific choice. Claiming
 * SoftwareSourceCode for something with no published source would be asserting
 * a fact that isn't there.
 */
// Falls back to this page's own URL, the same default Layout uses for the
// canonical tag, so the entity always states where it lives.
const resolvedCanonical =
  canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": repo ? "SoftwareSourceCode" : "CreativeWork",
  name: name ?? title ?? site.title,
  ...(description && { description }),
  url: resolvedCanonical,
  ...(ogImage && { image: ogImage }),
  ...(repo && { codeRepository: repo }),
  ...(url && { sameAs: [url] }),
  ...(pubDatetime && { dateCreated: pubDatetime.toISOString() }),
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: [
    {
      "@type": "Person",
      name: author ?? site.author,
      ...(site.profile && { url: site.profile }),
    },
  ],
};
---

<Layout {title} {description} {ogImage} {canonicalURL} ogType="article">
  <Fragment slot="head">
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>
