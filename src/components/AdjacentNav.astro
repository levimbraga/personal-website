---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { useTranslations } from "@/i18n";
import config from "@/config";

/**
 * Previous/next navigation for any collection.
 *
 * Takes resolved hrefs rather than a post id and file path, so the projects
 * pages can reuse it instead of owning a copy that drifts.
 */
type Adjacent = { title: string; href: string } | null;

type Props = {
  prev: Adjacent;
  next: Adjacent;
};

const { prev, next } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<div data-pagefind-ignore class="my-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
  {
    prev && (
      <a href={prev.href} class="flex w-full gap-1 hover:opacity-75">
        <IconArrowLeft class="inline-block flex-none rtl:rotate-180" />
        <div>
          <span>{t.post.previousPost}</span>
          <div class="text-accent/85 text-sm">{prev.title}</div>
        </div>
      </a>
    )
  }
  {
    next && (
      <a
        href={next.href}
        class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
      >
        <div>
          <span>{t.post.nextPost}</span>
          <div class="text-accent/85 text-sm">{next.title}</div>
        </div>
        <IconArrowRight class="inline-block flex-none rtl:rotate-180" />
      </a>
    )
  }
</div>
