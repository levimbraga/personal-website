---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import LinkButton from "./LinkButton.astro";
import IconStrawHat from "@/assets/icons/IconStrawHat.svg";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
const locale = Astro.currentLocale ?? config.site.lang;

/**
 * Deliberately vague. The link needs an accessible name — an icon-only link
 * with none is just "link" to a screen reader — but naming what it is would
 * hand over the surprise to exactly the people reading the label. This says
 * "optional, not part of the navigation" without saying what is there.
 */
const strawHatLabel = "Something extra";
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-border border-t py-6 sm:py-4">
    <div class="flex flex-col items-center justify-between sm:flex-row-reverse">
      {
        /*
        The socials and this one link share an outer flex with the same gap-1
        the socials use internally, so the extra icon is spaced exactly like
        its neighbours instead of being appended to a different container.
      */
      }
      <div class="flex flex-wrap items-center gap-1">
        <Socials />
        <LinkButton
          href={getRelativeLocaleUrl(locale, "straw-hat")}
          class="p-2 hover:rotate-6 sm:p-1"
          title={strawHatLabel}
        >
          <IconStrawHat
            class="inline-block size-6 scale-125 fill-transparent stroke-current stroke-2 opacity-90 sm:scale-110"
          />
          <span class="sr-only">{strawHatLabel}</span>
        </LinkButton>
      </div>
      <div
        class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row"
      >
        <span
          >{t.footer.copyright} &#169; {currentYear} {config.site.author}</span
        >
        <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
        <span>{t.footer.allRightsReserved}</span>
      </div>
    </div>
    {
      /*
      Courtesy credit. The MIT licence does not require visible attribution —
      the LICENSE file already satisfies it — but the theme is someone else's
      work and saying so costs one line.
    */
    }
    <div class="text-muted-foreground mt-2 text-center text-sm sm:text-start">
      {t.footer.theme}:{" "}
      <a
        href="https://github.com/satnaing/astro-paper"
        rel="noopener noreferrer"
        target="_blank"
        class="hover:text-accent underline decoration-dashed underline-offset-4"
      >
        AstroPaper
      </a>
    </div>
  </div>
</footer>
