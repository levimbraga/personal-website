---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getArchivedPosts } from "@/utils/getArchivedPosts";
import { getArchivedPostCount } from "@/utils/archiveIndexing";
import { getPostsByGroupCondition } from "./_utils/getPostsByGroupCondition";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const notFoundUrl = getRelativeLocaleUrl(locale, "404");

const archivedPosts = await getArchivedPosts();

/**
 * The sitemap filter in astro.config.ts has no content collections, so it
 * counts archived posts off the filesystem. Two counts computed two ways is
 * how this page ends up rewriting to 404 while the sitemap still advertises
 * it, so assert they agree — the same guard the tag route uses.
 */
const fsCount = getArchivedPostCount({
  scheduledPostMargin: config.posts.scheduledPostMargin,
});
if (fsCount !== archivedPosts.length) {
  throw new Error(
    `Archives: collections say ${archivedPosts.length} posts, ` +
      `filesystem scan says ${fsCount}. ` +
      `src/utils/archiveIndexing.ts has drifted from postFilter().`
  );
}

// Off by config, or nothing marked. An empty archive is worse than no archive:
// the nav entry disappears the same way, so the page must not be reachable.
if (
  (!config.features.showArchives || archivedPosts.length === 0) &&
  notFoundUrl
) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);

const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.archivesTitle} pageDesc={t.pages.archivesDesc}>
    {
      Object.entries(
        getPostsByGroupCondition(archivedPosts, post =>
          post.data.pubDatetime.getFullYear()
        )
      )
        .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
        .map(([year, yearGroup]) => (
          <div>
            <span class="text-2xl font-bold">{year}</span>
            <sup class="text-muted-foreground text-sm">{yearGroup.length}</sup>
            {Object.entries(
              getPostsByGroupCondition(
                yearGroup,
                post => post.data.pubDatetime.getMonth() + 1
              )
            )
              .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
              .map(([month, monthGroup]) => (
                <div class="flex flex-col sm:flex-row">
                  <div class="mt-6 min-w-36 text-lg sm:my-6">
                    <span class="font-bold">
                      {monthFormatter.format(
                        new Date(2000, Number(month) - 1, 1)
                      )}
                    </span>
                    <sup class="text-muted-foreground text-xs">
                      {monthGroup.length}
                    </sup>
                  </div>
                  <ul>
                    {monthGroup
                      .sort(
                        (a, b) =>
                          Math.floor(
                            new Date(b.data.pubDatetime).getTime() / 1000
                          ) -
                          Math.floor(
                            new Date(a.data.pubDatetime).getTime() / 1000
                          )
                      )
                      .map(data => (
                        <Card {...data} />
                      ))}
                  </ul>
                </div>
              ))}
          </div>
        ))
    }
  </Main>

  <Footer />
</Layout>
