---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ProjectLayout from "@/layouts/ProjectLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import AdjacentNav from "@/components/AdjacentNav.astro";
import ArticleEnhancements from "@/components/ArticleEnhancements.astro";
import { getProjectSlug, getProjectUrl } from "@/utils/getProjectPaths";
import { getSortedProjects } from "@/utils/getSortedProjects";
import { toTransitionName } from "@/utils/toTransitionName";
import config from "@/config";

/**
 * Structurally this is the post page: same back button, heading, date line,
 * article wrapper, dividers, share links, previous/next nav, and the same
 * reading-progress and code-copy behaviour.
 *
 * Two things differ, and both are content rather than form: the meta row
 * carries repository links where a post carries an edit link, and the stack
 * sits where a post's tags sit. Anything else drifting apart is a bug.
 */
export async function getStaticPaths() {
  const projects = getSortedProjects(await getCollection("projects"));

  return projects.map((project, index) => ({
    params: { slug: getProjectSlug(project.id) },
    props: {
      project,
      // Newest-first, matching the post page's convention.
      prevProject:
        index < projects.length - 1
          ? {
              id: projects[index + 1].id,
              title: projects[index + 1].data.title,
            }
          : null,
      nextProject:
        index > 0
          ? {
              id: projects[index - 1].id,
              title: projects[index - 1].data.title,
            }
          : null,
    },
  }));
}

type Adjacent = { id: string; title: string } | null;

type Props = {
  project: CollectionEntry<"projects">;
  prevProject: Adjacent;
  nextProject: Adjacent;
};

const { project, prevProject, nextProject } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const {
  title,
  description,
  author,
  status,
  repo,
  url,
  tech,
  pubDatetime,
  modDatetime,
  ogImage: initOgImage,
  canonicalURL,
} = project.data;

const { Content } = await render(project);

let ogImageUrl: string | undefined;

if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

if (!ogImageUrl && config.features.dynamicOgImage) {
  const projectUrl = getProjectUrl(project.id, locale).replace(/\/+$/, "");
  ogImageUrl = `${projectUrl}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

const links = [
  repo ? { href: repo, label: "Source on GitHub" } : null,
  url ? { href: url, label: "Live site" } : null,
].filter(link => link !== null);

const stack = [status, ...tech].filter(Boolean);
---

<ProjectLayout
  title={`${title} | ${config.site.title}`}
  name={title}
  {description}
  {author}
  {ogImage}
  {canonicalURL}
  {repo}
  {url}
  {pubDatetime}
  {modDatetime}
>
  <Header />

  <BackButton />

  <main
    id="main-content"
    class:list={["app-layout", { "mt-8": !config.features.showBackButton }]}
    data-pagefind-body
  >
    <h1
      style={{ viewTransitionName: toTransitionName(project.id) }}
      class="text-accent inline-block text-2xl font-bold sm:text-3xl"
    >
      {title}
    </h1>

    <div class="my-2 flex flex-wrap items-center gap-2">
      <Datetime {pubDatetime} {modDatetime} size="lg" />
      {
        links.map(link => (
          <>
            <span
              aria-hidden="true"
              class="text-muted-foreground max-sm:hidden"
            >
              |
            </span>
            <a
              href={link.href}
              rel="noopener noreferrer"
              target="_blank"
              class="hover:text-accent underline decoration-dashed underline-offset-4 max-sm:hidden"
            >
              {link.label}
            </a>
          </>
        ))
      }
    </div>

    <article
      id="article"
      class:list={[
        "mt-8 w-full",
        "app-prose max-w-app",
        "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
      ]}
    >
      <Content />
    </article>

    <hr class="my-8 border-dashed" />

    {
      links.length > 0 && (
        <p class="flex flex-wrap gap-4 sm:hidden">
          {links.map(link => (
            <a
              href={link.href}
              rel="noopener noreferrer"
              target="_blank"
              class="hover:text-accent underline decoration-dashed underline-offset-4"
            >
              {link.label}
            </a>
          ))}
        </p>
      )
    }

    <BackToTopButton />

    <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {stack.map(item => <li class="text-muted-foreground text-sm">{item}</li>)}
    </ul>

    <ShareLinks />

    <hr class="my-8 border-dashed" />

    <AdjacentNav
      prev={prevProject && {
        title: prevProject.title,
        href: getProjectUrl(prevProject.id, locale),
      }}
      next={nextProject && {
        title: nextProject.title,
        href: getProjectUrl(nextProject.id, locale),
      }}
    />
  </main>
  <Footer />
</ProjectLayout>

<ArticleEnhancements />
