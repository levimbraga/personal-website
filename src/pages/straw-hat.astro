---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import luffyArt from "@/assets/art/luffy.txt?raw";
import config from "@/config";

/**
 * Unlisted on purpose.
 *
 *  - Not in the nav (Header.astro never links it).
 *  - Not in the sitemap (filtered out in astro.config.ts).
 *  - Not in the search index (data-pagefind-ignore below).
 *  - Not disallowed in robots.txt — a Disallow line is a public list of the
 *    things you are hiding, which is the opposite of what this wants.
 *
 * The art is imported with `?raw` and printed with `set:text` rather than
 * pasted into the template. It is 62 lines of 142 Braille glyphs, and every
 * one of them is significant: `U+2800` is a blank braille cell, not a space,
 * and it is what holds the columns apart. Keeping it in its own .txt means
 * nothing in the toolchain reflows it, re-indents it, or trims a line end.
 */
const locale = Astro.currentLocale ?? config.site.lang;

/**
 * Braille is not in Google Sans Code — all twenty of the theme's font files
 * carry zero glyphs in U+2800-U+28FF, so the site font would hand this to
 * whatever the browser picked next and the drawing would collapse.
 *
 * So this one element gets its own stack. DejaVu Sans and Noto Sans Symbols 2
 * both carry the full 256-glyph block, and in both the block is uniform width
 * (every glyph the same advance), which is what actually matters here — a
 * proportional font is fine as long as the braille cells line up. Segoe UI
 * Symbol and Apple Symbols cover Windows and macOS.
 *
 * Note DejaVu Sans *Mono* is not in the list: despite the name it has no
 * braille at all, so listing it would only add a failed lookup.
 */
const brailleStack = [
  '"DejaVu Sans"',
  '"Noto Sans Symbols 2"',
  '"Noto Sans Symbols2"',
  '"Segoe UI Symbol"',
  '"Apple Symbols"',
  "monospace",
].join(", ");

/**
 * The font size is derived, not guessed.
 *
 * Measured from DejaVu Sans itself (the font the browser actually resolves
 * this stack to): every glyph in U+2800-U+28FF has an advance of 1500 units
 * against a 2048 unit em, i.e. exactly 0.732422em. Note that is nowhere near
 * the ~0.6em a typical monospaced face uses — the braille stack has its own
 * metric, so the usual rule of thumb would have been wrong here.
 *
 *   142 columns x 0.732422em            = 104.0039em total width
 *   to occupy 96vw:  96 / 104.0039      = 0.923vw per em
 *
 * So `font-size: 0.923vw` makes the drawing exactly 96vw wide at any viewport,
 * leaving 4vw of breathing room and never a horizontal scrollbar.
 *
 * `min()` caps it at 14px so a very wide monitor does not blow the art up to
 * fill 2560px; past ~1517px viewport it simply stops growing and centres.
 *
 * There is deliberately no floor. On a phone this comes out around 3.6px and
 * is unreadable up close — but the alternative is clipping the drawing, and a
 * complete miniature beats a cropped one you have to scroll.
 *
 * Line-height is exactly 1: braille fills its whole cell, so any leading opens
 * a visible white gap straight through the middle of the picture.
 */
const COLUMNS = 142;
const BRAILLE_ADVANCE_EM = 1500 / 2048; // 0.732422, measured from DejaVu Sans
const TOTAL_WIDTH_EM = COLUMNS * BRAILLE_ADVANCE_EM; // 104.0039
const FONT_SIZE_VW = (96 / TOTAL_WIDTH_EM).toFixed(3); // 0.923

const artStyle = [
  "white-space: pre",
  "line-height: 1",
  `font-size: min(${FONT_SIZE_VW}vw, 14px)`,
  `font-family: ${brailleStack}`,
  "font-variant-ligatures: none",
  "letter-spacing: 0",
  "tab-size: 1",
].join("; ");
---

<Layout
  title={`Straw Hat | ${config.site.title}`}
  description="An unlisted page."
>
  <Header />

  {
    /*
    This one page opts out of `app-layout`. That utility caps content at
    `max-w-3xl` (48rem), and the drawing is 104em wide — inside the normal
    container it could only ever be a horizontal scrollbar. Header and footer
    still use `app-layout`, so only the art escapes it.
  */
  }
  <main
    id="main-content"
    class="flex w-full flex-1 flex-col items-center justify-center py-12"
    data-pagefind-ignore
  >
    <p class="sr-only">ASCII art of Monkey D. Luffy from One Piece.</p>

    <div class="flex w-full justify-center">
      <pre
        class="text-accent m-0"
        style={artStyle}
        aria-hidden="true"
        set:text={luffyArt}
      />
    </div>

    <p class="text-muted-foreground mt-8 text-center italic">
      &quot;I&apos;m gonna be King of the Pirates!&quot;
    </p>

    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="hover:text-accent mt-6 text-sm underline decoration-dashed underline-offset-4"
    >
      Back home
    </a>
  </main>

  <Footer />
</Layout>
