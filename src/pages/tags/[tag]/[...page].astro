---
import { type CollectionEntry, getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getSortedProjects } from "@/utils/getSortedProjects";
import { slugifyAll } from "@/utils/slugify";
import { getTagCounts, TAG_INDEX_THRESHOLD } from "@/utils/tagIndexing";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Tagged = CollectionEntry<"posts"> | CollectionEntry<"projects">;

/**
 * A tag page lists everything carrying that tag, from either collection.
 *
 * Posts and projects are interleaved by last-touched date rather than grouped,
 * because the tag is the subject and the collection is an implementation
 * detail of where the file lives. Both collections already sort by the same
 * rule, so merging them needs no special case.
 */
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  const tags = getUniqueTags(posts, projects);
  const fsTagCounts = getTagCounts({
    scheduledPostMargin: config.posts.scheduledPostMargin,
  });

  const lastTouched = (entry: Tagged) =>
    new Date(entry.data.modDatetime ?? entry.data.pubDatetime).getTime();

  return tags.flatMap(({ tag, tagName }) => {
    const taggedPosts = getSortedPosts(
      posts.filter(({ data }) => slugifyAll(data.tags).includes(tag))
    );
    const taggedProjects = getSortedProjects(
      projects.filter(({ data }) => slugifyAll(data.tags).includes(tag))
    );

    const entries: Tagged[] = [...taggedProjects, ...taggedPosts].sort(
      (a, b) => lastTouched(b) - lastTouched(a)
    );

    /**
     * The sitemap filter in astro.config.ts cannot see content collections, so
     * it counts tags off the filesystem instead. Two counts computed two ways
     * is how a page ends up `noindex` *and* listed in the sitemap — a worse
     * signal than either alone — so assert here that they agree. If this ever
     * throws, the frontmatter rules in tagIndexing.ts have drifted from
     * postFilter().
     */
    const fsCount = fsTagCounts.get(tag) ?? 0;
    if (fsCount !== entries.length) {
      throw new Error(
        `Tag "${tag}": collections say ${entries.length} entries, ` +
          `filesystem scan says ${fsCount}. ` +
          `src/utils/tagIndexing.ts has drifted from postFilter().`
      );
    }

    return paginate(entries, {
      params: { tag },
      props: { tagName, entryCount: entries.length },
      pageSize: config.posts.perPage,
    });
  });
}

const { page, tagName, entryCount } = Astro.props;

/**
 * A tag page with fewer than TAG_INDEX_THRESHOLD entries is kept out of search
 * results and out of the sitemap. The same function decides both, so the two
 * signals cannot contradict each other — see src/utils/tagIndexing.ts.
 */
const thin = entryCount < TAG_INDEX_THRESHOLD;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout
  title={`${t.pages.tagTitle}: ${tagName} | ${config.site.title}`}
  noindex={thin}
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={`${t.pages.tagTitle}: ${tagName}`}
    pageDesc={`${t.pages.tagDesc} "${tagName}".`}
  >
    <ul>
      {
        page.data.map((entry: Tagged) =>
          entry.collection === "projects" ? (
            <ProjectCard {...(entry as CollectionEntry<"projects">)} />
          ) : (
            <Card {...(entry as CollectionEntry<"posts">)} />
          )
        )
      }
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
