---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import EntryCard from "@/components/EntryCard.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedEntries, type Entry } from "@/utils/getSortedEntries";
import { slugifyAll } from "@/utils/slugify";
import { getTagCounts, TAG_INDEX_THRESHOLD } from "@/utils/tagIndexing";
import { useTranslations } from "@/i18n";
import config from "@/config";

/**
 * A tag page lists everything carrying that tag, from either collection.
 *
 * The merge and the ordering live in `getSortedEntries`, shared with the home
 * page's Recent section, and the card dispatch in `EntryCard`.
 */
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  const tags = getUniqueTags(posts, projects);
  const fsTagCounts = getTagCounts({
    scheduledPostMargin: config.posts.scheduledPostMargin,
  });

  return tags.flatMap(({ tag, tagName }) => {
    const carriesTag = ({ data }: { data: { tags: string[] } }) =>
      slugifyAll(data.tags).includes(tag);

    const entries = getSortedEntries(
      posts.filter(carriesTag),
      projects.filter(carriesTag)
    );

    /**
     * The sitemap filter in astro.config.ts cannot see content collections, so
     * it counts tags off the filesystem instead. Two counts computed two ways
     * is how a page ends up `noindex` *and* listed in the sitemap — a worse
     * signal than either alone — so assert here that they agree. If this ever
     * throws, the frontmatter rules in tagIndexing.ts have drifted from
     * postFilter().
     */
    const fsCount = fsTagCounts.get(tag) ?? 0;
    if (fsCount !== entries.length) {
      throw new Error(
        `Tag "${tag}": collections say ${entries.length} entries, ` +
          `filesystem scan says ${fsCount}. ` +
          `src/utils/tagIndexing.ts has drifted from postFilter().`
      );
    }

    return paginate(entries, {
      params: { tag },
      props: { tagName, entryCount: entries.length },
      pageSize: config.posts.perPage,
    });
  });
}

const { page, tagName, entryCount } = Astro.props;

/**
 * A tag page with fewer than TAG_INDEX_THRESHOLD entries is kept out of search
 * results and out of the sitemap. The same function decides both, so the two
 * signals cannot contradict each other — see src/utils/tagIndexing.ts.
 */
const thin = entryCount < TAG_INDEX_THRESHOLD;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout
  title={`${t.pages.tagTitle}: ${tagName} | ${config.site.title}`}
  noindex={thin}
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={`${t.pages.tagTitle}: ${tagName}`}
    pageDesc={`${t.pages.tagDesc} "${tagName}".`}
  >
    <ul>
      {page.data.map((entry: Entry) => <EntryCard {entry} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
