---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

// Inline prose links: the theme's own hero link styling, kept in one place so
// the five links in the intro cannot drift apart.
const inlineLink =
  "hover:text-accent underline decoration-dashed underline-offset-4";

// getRelativeLocaleUrl appends a trailing slash, which turns rss.xml into the
// non-existent /rss.xml/. getAssetPath is the helper for files: it applies the
// base path without forcing a trailing slash.
const rssUrl = getAssetPath("rss.xml");

/**
 * Person structured data.
 *
 * This is what lets Google connect the domain to a human being rather than
 * treating it as an anonymous blog: `sameAs` is the standard signal for
 * "these profiles are the same entity as this site".
 *
 * `sameAs` is derived from `socials` in astro-paper.config.ts so the two can
 * never drift apart. `mailto:` links are excluded — `sameAs` is for profile
 * URLs, and an email address is not one.
 */
const siteUrl = Astro.site?.href ?? config.site.url;
const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: config.site.author,
  url: siteUrl,
  sameAs: socials
    .map(social => social.url)
    .filter(url => !url.startsWith("mailto:")),
};
---

<Layout>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personStructuredData)}
    />
  </Fragment>

  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    {
      /*
      The bottom border only earns its place when there is a posts section
      below it. With an empty blog the sign-off's own top border sits directly
      underneath, and the two render as a double rule. The theme already gates
      the featured section's border the same way.
    */
    }
    <section
      id="hero"
      class:list={[
        "border-border pt-8 pb-6",
        { "border-b": sortedPosts.length > 0 },
      ]}
    >
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Levi Maia Braga
      </h1>
      <p>
        I'm a computer science student in São Paulo, Brazil. I'm interested in
        backend systems, Python, Linux, databases, developer tools, and the
        offensive side of security.
      </p>

      <p class="mt-4">
        What I like most are tools that take something ugly and complicated and
        hand it to you as three clean lines. Stripe did it for payments, Sentry
        for knowing why your app broke. That shape is what I want to build.
      </p>

      <p class="mt-4">
        Right now I'm working through data structures and algorithms every day,
        and planning <a href="https://ormaos.com" class={inlineLink}>Ormaos</a>,
        a tool for understanding what happens inside a Python execution.
      </p>

      <p class="mt-4">
        This site is where I write things down. Mostly what I build and what I
        measure, sometimes what I got wrong and had to correct.
      </p>

      <p class="mt-4">
        Feel free to check out my <a
          href={getRelativeLocaleUrl(locale, "projects")}
          class={inlineLink}>projects</a
        > and my <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class={inlineLink}>blog posts</a
        >. There's an <a href={rssUrl} class={inlineLink}>RSS feed</a> too!
      </p>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      sortedPosts.length > 0 && (
        <div class="my-8 text-center">
          <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
            {t.home.allPosts}
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      )
    }

    {
      /*
      Page sign-off. Sits at the end of <main> rather than directly under the
      intro so it still closes the page once there are posts above it.

      The backslash in the kaomoji is literal here — this is an Astro HTML
      template, not Markdown, so it needs no escaping. The "<3" does: written
      raw it would start a tag. It is `&lt;3` in the source and renders as <3.
    */
    }
    <div class="border-border mt-12 border-t pt-10 pb-6 text-center">
      <p class="text-muted-foreground font-app text-4xl sm:text-5xl">\(^o^)/</p>
      <p class="text-muted-foreground mt-4 text-sm">
        thanks for stopping by &lt;3
      </p>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
