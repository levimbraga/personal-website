---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import EntryCard from "@/components/EntryCard.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedEntries } from "@/utils/getSortedEntries";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

/**
 * Both collections, interleaved by date — a reader landing here wants the
 * latest thing, and whether it was filed as a post or a project is not their
 * problem. `getSortedEntries` is the same helper the tag pages use.
 *
 * The featured split runs over the merged list rather than over posts alone.
 * If it did not, a project marked `featured` would show up in Featured *and*
 * in Recent, because Recent is defined as "everything not featured".
 */
const posts = await getCollection("posts");
const projects = await getCollection("projects");
const entries = getSortedEntries(posts, projects);
const featuredEntries = entries.filter(({ data }) => data.featured);
const recentEntries = entries.filter(({ data }) => !data.featured);

// Derived from the merged list, not from the raw collections: a blog holding
// nothing but drafts must not put an "All Posts" link under the section.
const hasPosts = entries.some(entry => entry.collection === "posts");
const hasProjects = entries.some(entry => entry.collection === "projects");
const homePath = getRelativeLocaleUrl(locale, "");

// Inline prose links: the theme's own hero link styling, kept in one place so
// the five links in the intro cannot drift apart.
const inlineLink =
  "hover:text-accent underline decoration-dashed underline-offset-4";

// getRelativeLocaleUrl appends a trailing slash, which turns rss.xml into the
// non-existent /rss.xml/. getAssetPath is the helper for files: it applies the
// base path without forcing a trailing slash.
const rssUrl = getAssetPath("rss.xml");

/**
 * Person structured data.
 *
 * This is what lets Google connect the domain to a human being rather than
 * treating it as an anonymous blog: `sameAs` is the standard signal for
 * "these profiles are the same entity as this site".
 *
 * `sameAs` is derived from `socials` in astro-paper.config.ts so the two can
 * never drift apart. `mailto:` links are excluded — `sameAs` is for profile
 * URLs, and an email address is not one.
 */
const siteUrl = Astro.site?.href ?? config.site.url;
const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: config.site.author,
  url: siteUrl,
  sameAs: socials
    .map(social => social.url)
    .filter(url => !url.startsWith("mailto:")),
};
---

<Layout>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personStructuredData)}
    />
  </Fragment>

  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    {
      /*
      The bottom border only earns its place when there is a Recent section
      below it. With nothing published the sign-off's own top border sits
      directly underneath, and the two render as a double rule. The theme
      already gates the featured section's border the same way.
    */
    }
    <section
      id="hero"
      class:list={[
        "border-border pt-8 pb-6",
        { "border-b": entries.length > 0 },
      ]}
    >
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Levi Maia Braga
      </h1>
      <p>
        I’m a computer science student in São Paulo, Brazil. I build developer
        tools, and right now I’m building <a
          href="https://ormaos.com"
          target="_blank"
          rel="noopener noreferrer"
          class={inlineLink}>Ormaos</a
        >: a tool for understanding what happened inside a Python execution. It
        records what a program did when it ran (the calls, the exceptions,
        including the ones that were swallowed, and the path the code took) and
        hands it to you and to your coding agent. It runs locally and it’s open
        source.
      </p>

      <p class="mt-4">
        I love the layer under the code. I want to know what really happens
        when a program runs: how Python executes a line, what the operating
        system does underneath, where the time goes, and what a GPU is actually
        doing. My favorite kind of software takes something messy and
        complicated and gives it back to you clear enough to act on.
      </p>

      <p class="mt-4">
        I’m just as drawn to AI: machine learning, reinforcement learning, the
        data that models learn from, and physical AI, where intelligence moves
        from bits to atoms. I think the most interesting problems of the next
        decade sit where systems and AI meet, and that’s where I want to work.
      </p>

      <p class="mt-4">
        I learn by building. I’m going through computer science from the ground
        up with the open courses of MIT, Berkeley and Stanford, doing the
        problem sets and the labs instead of only watching, and I practice data
        structures and algorithms every day. When I build something, I measure
        it, and I write down what I got wrong.
      </p>

      <p class="mt-4">
        This site is where that goes: what I build, what I measure, and what I
        had to fix.
      </p>

      <p class="mt-4">
        Feel free to check out my <a
          href={getRelativeLocaleUrl(locale, "projects")}
          class={inlineLink}>projects</a
        > and my <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class={inlineLink}>blog posts</a
        >. There’s an <a href={rssUrl} class={inlineLink}>RSS feed</a> too!
      </p>
    </section>

    {
      featuredEntries.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentEntries.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredEntries.map(entry => (
              <EntryCard {entry} variant="h3" />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentEntries.length > 0 && (
        <section id="recent" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">{t.home.recent}</h2>
          <ul>
            {recentEntries.slice(0, postsConfig.perIndex).map(entry => (
              <EntryCard {entry} variant="h3" />
            ))}
          </ul>
        </section>
      )
    }

    {
      /*
      One link per collection, because the list above spans both and a single
      "All Posts" under it would promise an index that does not contain half of
      what the reader just saw. Each is gated on its own collection having
      anything in it, so an empty one leaves no dead link behind.
    */
    }
    {
      entries.length > 0 && (
        <div class="my-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
          {hasPosts && (
            <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
              {t.home.allPosts}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          )}
          {hasProjects && (
            <LinkButton href={getRelativeLocaleUrl(locale, "projects")}>
              {t.home.allProjects}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          )}
        </div>
      )
    }

    {
      /*
      Page sign-off. Sits at the end of <main> rather than directly under the
      intro so it still closes the page once there are posts above it.

      The backslash in the kaomoji is literal here — this is an Astro HTML
      template, not Markdown, so it needs no escaping. The "<3" does: written
      raw it would start a tag. It is `&lt;3` in the source and renders as <3.
    */
    }
    <div class="border-border mt-12 border-t pt-10 pb-6 text-center">
      <p class="text-muted-foreground font-app text-4xl sm:text-5xl">\(^o^)/</p>
      <p class="text-muted-foreground mt-4 text-sm">
        thanks for stopping by &lt;3
      </p>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
